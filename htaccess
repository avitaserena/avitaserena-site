# ── Avita Serena · Configuration OVH Apache ──

Options -Indexes

# ── Redirections URL courtes ──
RewriteEngine On

# /praticien → espace praticien
RewriteRule ^praticien/?$ /outils/index.html [L,R=302]

# /pro → espace praticien
RewriteRule ^pro/?$ /outils/index.html [L,R=302]

# /bilan → questionnaire cliente
RewriteRule ^bilan/?$ /questionnaire_cliente_avitaserena.html [L,R=302]

# /questionnaire → questionnaire cliente
RewriteRule ^questionnaire/?$ /questionnaire_cliente_avitaserena.html [L,R=302]

# /programmes → page programmes
RewriteRule ^programmes/?$ /programmes.html [L,R=302]

# /reservation ou /reserver → page réservation
RewriteRule ^reservation/?$ /reservation.html [L,R=302]
RewriteRule ^reserver/?$ /reservation.html [L,R=302]

# /manifeste → manifeste
RewriteRule ^manifeste/?$ /manifeste.html [L,R=302]

# ── Bloquer l'indexation de /outils/ ──
<DirectoryMatch "^.*outils/">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</DirectoryMatch>

# ── Page 404 personnalisée (optionnel) ──
# ErrorDocument 404 /404.html
